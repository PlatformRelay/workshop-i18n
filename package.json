{
  "name": "workshop-i18n-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Git-native localization CLI for Slidev workshops: extract PO catalogs, compose locale decks with governed overrides, track staleness",
  "license": "MIT",
  "author": "Konrad Heimel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlatformRelay/workshop-i18n.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --filter './packages/*' exec tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
